// Nested conditionals, unary minus, and returns from inside branches — the
// combination that stresses basic-block termination in codegen.
fn classify(n) {
  if (n < 0) {
    return -1;
  } else {
    if (n == 0) {
      return 0;
    } else {
      return 1;
    }
  }
}

fn main() {
  // -1 + 0 + 1 = 0, then + 42
  return classify(-5) + classify(0) + classify(9) + 42;   // 42
}
