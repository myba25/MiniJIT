# Normalise line endings so the repo is identical regardless of platform.
* text=auto

# PowerShell 5.1 is happiest with CRLF, and these scripts must stay ASCII:
# it decodes files as Windows-1252 unless they carry a byte order mark.
*.ps1 text eol=crlf

# Keep shell scripts and CI config LF even when checked out on Windows.
*.sh  text eol=lf
*.yml text eol=lf

# Language samples are plain text.
*.mini text
